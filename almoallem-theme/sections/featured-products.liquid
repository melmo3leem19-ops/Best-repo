{%- comment -%}
  Featured Products Section — v9 (Phase 4 premium multi-layout engine)
  Changes vs v8 (all backward compatible — defaults reproduce v8 exactly):
  1. New layout modes for desktop AND mobile alongside grid/carousel:
     bento, editorial, luxury, storytelling. Implemented as per-mode CSS
     classes (assets/featured-products-modes.css) over the SAME product
     loop / card markup; grid + carousel inline CSS is byte-identical.
  2. Phase 2 badge integration: {% render 'badge-system' %} over the card
     image (guarded — fails silently if the snippet is missing).
  3. New merchant controls: animation preset, card hover effect (lift /
     glass), title/price weight + letter-spacing, card shadow intensity,
     split desktop/mobile gaps, heading alignment, badge toggle.
  4. a11y/RTL: reveal animations honor prefers-reduced-motion, arrows use
     localized aria-labels, all new CSS uses logical properties.
  Kept from v8:
  - RTL arrow ICONS flip ([dir="rtl"] scaleX(-1))
  - Cart drawer updates without page refresh via /cart/add.js sections=[...]
{%- endcomment -%}

{%- assign ai_gen_id = section.id | replace: '_', '' | replace: '-', '' | downcase -%}

{%- liquid
  assign image_ratio_val = '100%'
  if section.settings.image_ratio == 'portrait'
    assign image_ratio_val = '133%'
  elsif section.settings.image_ratio == 'landscape'
    assign image_ratio_val = '75%'
  elsif section.settings.image_ratio == 'wide'
    assign image_ratio_val = '56.25%'
  elsif section.settings.image_ratio == 'custom'
    assign image_ratio_val = section.settings.image_ratio_custom | append: '%'
  endif

  assign layout_desktop = section.settings.layout_desktop
  assign layout_mobile  = section.settings.layout_mobile

  comment
    Phase 4 additions. Every derived value below falls back to the exact
    v8 behavior when the new settings are absent or left at their defaults.
  endcomment
  assign hover_effect = section.settings.hover_effect | default: 'default'
  assign anim_preset  = section.settings.animation_preset | default: 'none'
  assign heading_align = section.settings.heading_align | default: 'default'

  assign gap_desktop_val = section.settings.gap
  assign gap_mobile_val  = section.settings.gap
  if section.settings.gap_split
    assign gap_desktop_val = section.settings.gap_desktop | default: section.settings.gap
    assign gap_mobile_val  = section.settings.gap_mobile | default: section.settings.gap
  endif

  assign reveal_enabled = false
  if anim_preset != 'none' or layout_desktop == 'luxury' or layout_mobile == 'luxury'
    assign reveal_enabled = true
  endif

  assign show_badges = section.settings.show_badges
-%}

{{ 'featured-products-modes.css' | asset_url | stylesheet_tag }}

{% style %}
  .ai-fp-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  .ai-fp__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .ai-fp__header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }
  .ai-fp__heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
    line-height: 1.2;
    flex: 1;
  }
  .ai-fp__viewall-{{ ai_gen_id }} {
    display: inline-block;
    padding: 10px 20px;
    background: {{ section.settings.viewall_bg }};
    color: {{ section.settings.viewall_text }};
    text-decoration: none;
    border-radius: {{ section.settings.viewall_radius }}px;
    font-size: 14px;
    font-weight: 600;
    transition: background 0.3s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .ai-fp__viewall-{{ ai_gen_id }}:hover { background: {{ section.settings.viewall_bg_hover }}; }
  .ai-fp__viewall-bottom-{{ ai_gen_id }} {
    margin-top: 24px;
    display: flex;
    justify-content: {{ section.settings.viewall_bottom_align }};
  }

  .ai-fp__products-{{ ai_gen_id }} { position: relative; }

  /* Shared list */
  .ai-fp__list-{{ ai_gen_id }} {
    gap: {{ section.settings.gap }}px;
    scrollbar-width: none;
    -ms-overflow-style: none;
    --is-carousel: 0;
  }
  .ai-fp__list-{{ ai_gen_id }}::-webkit-scrollbar { display: none; }
  {% if section.settings.gap_split %}
    @media screen and (min-width: 750px) { .ai-fp__list-{{ ai_gen_id }} { gap: {{ gap_desktop_val }}px; } }
    @media screen and (max-width: 749px) { .ai-fp__list-{{ ai_gen_id }} { gap: {{ gap_mobile_val }}px; } }
  {% endif %}

  /* ══ DESKTOP layout ══
     bento / editorial / luxury / storytelling are styled from
     assets/featured-products-modes.css via .ai-fp--d-* classes. */
  {% if layout_desktop == 'carousel' %}
    @media screen and (min-width: 750px) {
      .ai-fp__list-{{ ai_gen_id }} {
        display: flex;
        overflow-x: auto;
        scroll-behavior: smooth;
        --is-carousel: 1;
      }
      .ai-fp__item-{{ ai_gen_id }} {
        flex: 0 0 calc((100% - ({{ section.settings.visible_desktop }} - 1) * {{ gap_desktop_val }}px) / {{ section.settings.visible_desktop }});
      }
    }
  {% elsif layout_desktop == 'grid' %}
    @media screen and (min-width: 750px) {
      .ai-fp__list-{{ ai_gen_id }} {
        display: grid;
        grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      }
    }
  {% endif %}

  /* ══ MOBILE layout ══ */
  {% if layout_mobile == 'carousel' %}
    @media screen and (max-width: 749px) {
      .ai-fp__list-{{ ai_gen_id }} {
        display: flex;
        overflow-x: auto;
        scroll-behavior: smooth;
        --is-carousel: 1;
      }
      .ai-fp__item-{{ ai_gen_id }} {
        flex: 0 0 calc((100% - ({{ section.settings.visible_mobile }} - 1) * {{ gap_mobile_val }}px) / {{ section.settings.visible_mobile }});
      }
    }
  {% elsif layout_mobile == 'grid' %}
    @media screen and (max-width: 749px) {
      .ai-fp__list-{{ ai_gen_id }} {
        display: grid;
        grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      }
    }
  {% endif %}

  /* ── Arrows wrapper ── */
  .ai-fp__products-{{ ai_gen_id }} { position: relative; z-index: 0; }

.ai-fp__arrows-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }
  .ai-fp__arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    background: {{ section.settings.arrow_bg }};
    color: {{ section.settings.arrow_color }};
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: {{ section.settings.arrow_opacity | divided_by: 100.0 }};
    transition: background 0.25s, opacity 0.25s, transform 0.25s;
    box-shadow: 0 2px 8px rgba(0,0,0,0.18);
    pointer-events: all;
  }
  .ai-fp__arrow-{{ ai_gen_id }}:hover {
    background: {{ section.settings.arrow_bg_hover }};
    opacity: {{ section.settings.arrow_opacity_hover | divided_by: 100.0 }};
    transform: translateY(-50%) scale(1.08);
  }
  .ai-fp__arrow-{{ ai_gen_id }}:disabled { opacity: 0.2; pointer-events: none; }

  /* Logical positions — these flip automatically in RTL */
  .ai-fp__arrow-prev-{{ ai_gen_id }} { inset-inline-start: -16px; }
  .ai-fp__arrow-next-{{ ai_gen_id }} { inset-inline-end:   -16px; }
  .ai-fp__arrow-{{ ai_gen_id }} svg { width: 20px; height: 20px; }

  /* ════════════════════════════════════════════════════════
     FIX: Flip arrow ICONS in RTL so they point the right way.
     In LTR: prev = left-chevron (<), next = right-chevron (>)
     In RTL: prev = right-chevron (>), next = left-chevron (<)
     scaleX(-1) mirrors the SVG horizontally.
     ════════════════════════════════════════════════════════ */
  [dir="rtl"] .ai-fp__arrow-{{ ai_gen_id }} svg {
    transform: scaleX(-1);
  }

  /* Hide arrows on viewports where layout is GRID */
  {% if layout_desktop != 'carousel' %}
    @media screen and (min-width: 750px) { .ai-fp__arrows-{{ ai_gen_id }} { display: none; } }
  {% endif %}
  {% if layout_mobile != 'carousel' %}
    @media screen and (max-width: 749px) { .ai-fp__arrows-{{ ai_gen_id }} { display: none; } }
  {% endif %}

  /* ── Cards ── */
  .ai-fp__item-{{ ai_gen_id }} {
    background: {{ section.settings.card_bg }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s;
    {% if section.settings.card_border_width > 0 %}
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    {% endif %}
  }
  .ai-fp__item-{{ ai_gen_id }}:hover { transform: translateY(-4px); box-shadow: 0 6px 20px rgba(0,0,0,0.1); }

  .ai-fp__img-wrap-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    padding-bottom: {{ image_ratio_val }};
    background: {{ section.settings.image_bg }};
    overflow: hidden;
  }
  .ai-fp__img-wrap-{{ ai_gen_id }} img {
    position: absolute; top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: {{ section.settings.image_fit }};
    transition: transform 0.4s ease;
  }
  {% if section.settings.image_hover_zoom %}
  .ai-fp__item-{{ ai_gen_id }}:hover .ai-fp__img-wrap-{{ ai_gen_id }} img { transform: scale(1.06); }
  {% endif %}
  .ai-fp__img-placeholder-{{ ai_gen_id }} {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
  }
  .ai-fp__img-placeholder-{{ ai_gen_id }} svg { width: 60%; height: 60%; max-width: 200px; }

  .ai-fp__info-{{ ai_gen_id }} { padding: {{ section.settings.card_padding }}px; }
  .ai-fp__title-{{ ai_gen_id }} {
    margin: 0 0 6px;
    font-size: {{ section.settings.title_size }}px;
    color: {{ section.settings.title_color }};
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.4;
  }
  .ai-fp__title-{{ ai_gen_id }} a { color: inherit; text-decoration: none; }
  .ai-fp__price-{{ ai_gen_id }} {
    font-size: {{ section.settings.price_size }}px;
    color: {{ section.settings.price_color }};
    font-weight: 600;
    margin-bottom: 8px;
  }
  .ai-fp__select-{{ ai_gen_id }} {
    width: 100%;
    padding: 8px 12px;
    margin-bottom: 8px;
    border: 1px solid #ddd;
    border-radius: {{ section.settings.atc_radius }}px;
    font-size: {{ section.settings.atc_font_size }}px;
    background: #fff;
  }
  .ai-fp__atc-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ section.settings.atc_padding_v }}px {{ section.settings.atc_padding_h }}px;
    background: {{ section.settings.atc_bg }};
    color: {{ section.settings.atc_text_color }};
    border: none;
    border-radius: {{ section.settings.atc_radius }}px;
    font-size: {{ section.settings.atc_font_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.3s, opacity 0.3s;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ai-fp__atc-{{ ai_gen_id }}:hover:not(:disabled) { background: {{ section.settings.atc_bg_hover }}; }
  .ai-fp__atc-{{ ai_gen_id }}:disabled { opacity: 0.5; cursor: default; }

  /* ── Phase 4 controls — each block emits nothing at its default value ── */
  {% if heading_align != 'default' %}
  .ai-fp__heading-{{ ai_gen_id }} { text-align: {{ heading_align }}; }
  {% endif %}
  {% if section.settings.title_weight != blank and section.settings.title_weight != 'default' %}
  .ai-fp__title-{{ ai_gen_id }} { font-weight: {{ section.settings.title_weight }}; }
  {% endif %}
  {% if section.settings.title_tracking != blank and section.settings.title_tracking != 0 %}
  .ai-fp__title-{{ ai_gen_id }} { letter-spacing: {{ section.settings.title_tracking }}px; }
  {% endif %}
  {% if section.settings.price_weight != blank and section.settings.price_weight != 'default' %}
  .ai-fp__price-{{ ai_gen_id }} { font-weight: {{ section.settings.price_weight }}; }
  {% endif %}
  {% if section.settings.price_tracking != blank and section.settings.price_tracking != 0 %}
  .ai-fp__price-{{ ai_gen_id }} { letter-spacing: {{ section.settings.price_tracking }}px; }
  {% endif %}
  {% if section.settings.shadow_intensity != blank and section.settings.shadow_intensity > 0 %}
  .ai-fp__item-{{ ai_gen_id }} { box-shadow: 0 6px 18px rgba(0,0,0,{{ section.settings.shadow_intensity | divided_by: 250.0 }}); }
  {% endif %}
{% endstyle %}

{%- liquid
  assign products      = section.settings.products
  assign product_count = products.count | default: 0
  assign show_viewall  = false
  if section.settings.show_view_all and section.settings.view_all_link != blank
    assign show_viewall = true
  endif
-%}

<featured-products-section-{{ ai_gen_id }}
  class="ai-fp-{{ ai_gen_id }} ai-fp ai-fp--d-{{ layout_desktop }} ai-fp--m-{{ layout_mobile }} ai-fp--hover-{{ hover_effect }}{% if anim_preset != 'none' %} ai-fp--anim-{{ anim_preset }}{% endif %}"
  style="--fp-gap-desktop: {{ gap_desktop_val }}px; --fp-gap-mobile: {{ gap_mobile_val }}px; --fp-radius: {{ section.settings.card_radius }}px;"
  {{ section.shopify_attributes }}
>
  <div class="ai-fp__container-{{ ai_gen_id }}">

    <div class="ai-fp__header-{{ ai_gen_id }}">
      {%- if section.settings.heading != blank -%}
        <h2 class="ai-fp__heading-{{ ai_gen_id }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if show_viewall and section.settings.view_all_position == 'top' -%}
        <a href="{{ section.settings.view_all_link }}" class="ai-fp__viewall-{{ ai_gen_id }}">{{ section.settings.view_all_text }}</a>
      {%- endif -%}
    </div>

    <div class="ai-fp__products-{{ ai_gen_id }}">
      {%- if section.settings.show_arrows -%}
        <div class="ai-fp__arrows-{{ ai_gen_id }}">
          <button class="ai-fp__arrow-{{ ai_gen_id }} ai-fp__arrow ai-fp__arrow-prev-{{ ai_gen_id }}" aria-label="{{ 'accessibility.slideshow_previous' | t }}" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <polyline points="15 18 9 12 15 6"/>
            </svg>
          </button>
          <button class="ai-fp__arrow-{{ ai_gen_id }} ai-fp__arrow ai-fp__arrow-next-{{ ai_gen_id }}" aria-label="{{ 'accessibility.slideshow_next' | t }}" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </button>
        </div>
      {%- endif -%}

      <div class="ai-fp__list-{{ ai_gen_id }} ai-fp__list" data-list>
        {%- if product_count > 0 -%}
          {%- for product in products -%}
            {%- liquid
              assign pimg = product.featured_image
              if product.media.size > 0
                assign pimg = product.media[0].preview_image
              endif
              assign multi = false
              if product.variants.size > 1
                assign multi = true
              endif
            -%}
            <div class="ai-fp__item-{{ ai_gen_id }} ai-fp__item"{% if reveal_enabled %} data-fp-reveal{% endif %}{% if anim_preset == 'stagger' %} style="--fp-i: {{ forloop.index0 }};"{% endif %}>
              <a href="{{ product.url }}" class="ai-fp__img-wrap-{{ ai_gen_id }} ai-fp__media">
                {%- if pimg != blank -%}
                  <img src="{{ pimg | image_url: width: 600 }}" alt="{{ pimg.alt | escape }}" width="600" height="600" loading="lazy">
                {%- else -%}
                  <div class="ai-fp__img-placeholder-{{ ai_gen_id }}">{{ 'product-1' | placeholder_svg_tag }}</div>
                {%- endif -%}
                {%- if show_badges -%}
                  {%- comment -%} Phase 2 badge system — guarded so a missing snippet fails silently. {%- endcomment -%}
                  {%- capture fp_badge -%}{%- render 'badge-system', product: product, context: 'card' -%}{%- endcapture -%}
                  {%- unless fp_badge contains 'Liquid error' -%}{{ fp_badge }}{%- endunless -%}
                {%- endif -%}
              </a>
              <div class="ai-fp__info-{{ ai_gen_id }} ai-fp__info">
                <h3 class="ai-fp__title-{{ ai_gen_id }} ai-fp__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>

                {%- comment -%} ═════════════════════ PRICE WITH VARIANT PLACEHOLDER ═════════════════════ {%- endcomment -%}
                <div class="ai-fp__price-{{ ai_gen_id }} ai-fp__price" data-price-wrapper>
                  {%- if multi -%}
                    {{ 'content.price_on_selection' | t }}
                  {%- else -%}
                    {{ product.price | money }}
                  {%- endif -%}
                </div>

                {%- if section.settings.show_quick_add -%}
                  {%- if multi -%}
                    <select class="ai-fp__select-{{ ai_gen_id }}" data-variant-select>
                      <option value="" disabled selected>{{ section.settings.variant_placeholder }}</option>
                      {%- for variant in product.variants -%}
                        <option
                          value="{{ variant.id }}"
                          data-variant-price="{{ variant.price | money }}"
                          {% unless variant.available %}disabled{% endunless %}
                        >
                          {{ variant.title }}{% unless variant.available %} – {{ 'products.product.sold_out' | t | default: 'Sold out' }}{% endunless %}
                        </option>
                      {%- endfor -%}
                    </select>
                  {%- endif -%}
                  <button
                    type="button"
                    class="ai-fp__atc-{{ ai_gen_id }}"
                    data-atc
                    data-vid="{% unless multi %}{{ product.variants.first.id }}{% endunless %}"
                    {% if multi or product.available == false %}disabled{% endif %}
                  >
                    {%- if product.available -%}{{ section.settings.atc_text }}{%- else -%}{{ section.settings.soldout_text }}{%- endif -%}
                  </button>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..section.settings.columns_desktop) -%}
            <div class="ai-fp__item-{{ ai_gen_id }} ai-fp__item">
              <div class="ai-fp__img-wrap-{{ ai_gen_id }} ai-fp__media">
                <div class="ai-fp__img-placeholder-{{ ai_gen_id }}">{{ 'product-1' | placeholder_svg_tag }}</div>
              </div>
              <div class="ai-fp__info-{{ ai_gen_id }} ai-fp__info">
                <h3 class="ai-fp__title-{{ ai_gen_id }} ai-fp__title">{{ 'onboarding.product_title' | t }}</h3>
                <div class="ai-fp__price-{{ ai_gen_id }} ai-fp__price">0.000 KWD</div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    {%- if show_viewall and section.settings.view_all_position == 'bottom' -%}
      <div class="ai-fp__viewall-bottom-{{ ai_gen_id }}">
        <a href="{{ section.settings.view_all_link }}" class="ai-fp__viewall-{{ ai_gen_id }}">{{ section.settings.view_all_text }}</a>
      </div>
    {%- endif -%}

  </div>
</featured-products-section-{{ ai_gen_id }}>

<script>
(function () {
  'use strict';

  var SECTION_ID = '{{ ai_gen_id }}';

  /* ════════════════════════════════════════════════════════════════
     CART HELPERS
     Key insight: /cart/add.js accepts a `sections` array in the body.
     Shopify renders those sections and returns their HTML inside
     data.sections — we inject that HTML into the DOM directly.
     This is the native mechanism the theme uses via its own forms.
     We also dispatch 'cart:update' which is CartAddEvent.eventName
     in this theme (from assets/events.js: ThemeEvents.cartUpdate).
     The cart-drawer-component element listens for this event.
     ════════════════════════════════════════════════════════════════ */

  /* Section IDs to request — Shopify ignores IDs that don't exist */
  var CART_SECTIONS = ['cart-drawer', 'cart-icon-bubble', 'cart-notification'];

  async function addToCartWithSections(variantId) {
    const res = await fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify({
        id: Number(variantId),
        quantity: 1,
        sections: CART_SECTIONS
      })
    });

    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error(err.description || 'Add to cart failed');
    }

    return res.json();
  }

  function injectSectionHTML(sections) {
    if (!sections || typeof sections !== 'object') return;
    Object.entries(sections).forEach(function ([sectionId, html]) {
      if (!html) return;
      const wrapper = document.getElementById('shopify-section-' + sectionId);
      if (!wrapper) return;
      /* Parse the returned HTML and replace the wrapper's innerHTML */
      const doc   = new DOMParser().parseFromString(html, 'text/html');
      const fresh = doc.getElementById('shopify-section-' + sectionId);
      if (fresh) {
        wrapper.innerHTML = fresh.innerHTML;
      } else {
        /* Fallback: the section render may not include a wrapper */
        wrapper.innerHTML = html;
      }
    });
  }

  function updateCartCount(itemCount) {
    if (typeof itemCount !== 'number') return;
    document.querySelectorAll(
      '.cart-count, .cart__count, #CartCount, [data-cart-count], [data-cart-item-count], .js-cart-count, .cart-item-count, .cart-count-bubble'
    ).forEach(function (el) { el.textContent = itemCount; });
  }

  function dispatchCartUpdate(cartData, sections) {
    /*
      Dispatch 'cart:update' — this is CartAddEvent.eventName in assets/events.js.
      The cart-drawer-component listens for this and will auto-open if it has
      the `auto-open` attribute. Passing `sections` lets any theme listener
      know which sections were updated.
    */
    document.dispatchEvent(new CustomEvent('cart:update', {
      bubbles: true,
      detail: {
        resource: cartData,
        sourceId: 'featured-products-section-' + SECTION_ID,
        data: {
          source: 'product-form',
          itemCount: cartData && cartData.item_count,
          sections: sections || {}
        }
      }
    }));
  }

  function openCartDrawer(triggerEl) {
    /* cart-drawer-component is the custom element defined in assets/cart-drawer.js */
    const drawer = document.querySelector('cart-drawer-component');
    if (drawer) {
      if (typeof drawer.open === 'function') { drawer.open(triggerEl); return; }
      if (typeof drawer.showDialog === 'function') { drawer.showDialog(); return; }
    }
    /* Fallback for other cart implementations */
    const notif = document.querySelector('cart-notification');
    if (notif && typeof notif.open === 'function') { notif.open(triggerEl); return; }
    const fallbackSelectors = ['#CartDrawer', '#cart-drawer', '.cart-drawer', '[data-cart-drawer]'];
    for (const sel of fallbackSelectors) {
      const el = document.querySelector(sel);
      if (el) {
        el.classList.add('is-open', 'active');
        el.removeAttribute('hidden');
        return;
      }
    }
  }

  /* ════════════════════════════════════════════════════════════════
     CUSTOM ELEMENT
     ════════════════════════════════════════════════════════════════ */
  class FeaturedProductsSection extends HTMLElement {
    connectedCallback() {
      this.listEl   = this.querySelector('[data-list]');
      this.prevBtn  = this.querySelector('.ai-fp__arrow-prev-' + SECTION_ID);
      this.nextBtn  = this.querySelector('.ai-fp__arrow-next-' + SECTION_ID);

      if (this.listEl) {
        if (this.prevBtn) this.prevBtn.addEventListener('click', () => this.slide('prev'));
        if (this.nextBtn) this.nextBtn.addEventListener('click', () => this.slide('next'));
        this.listEl.addEventListener('scroll', () => this.refreshArrows(), { passive: true });
        window.addEventListener('resize', () => this.refreshArrows(), { passive: true });
        requestAnimationFrame(() => this.refreshArrows());
      }

      this.setupATC();
      this.setupReveal();
    }

    disconnectedCallback() {
      if (this.revealObserver) {
        this.revealObserver.disconnect();
        this.revealObserver = null;
      }
    }

    /* Reveal-on-scroll for animation presets / luxury mode.
       The hidden state only applies once .ai-fp-js is added here, so a JS
       failure never hides products. Honors prefers-reduced-motion. */
    setupReveal() {
      const items = this.querySelectorAll('[data-fp-reveal]');
      if (!items.length) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (reduceMotion.matches || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-revealed'));
        return;
      }

      this.classList.add('ai-fp-js');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            io.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });

      items.forEach((el) => io.observe(el));
      this.revealObserver = io;

      /* If the user enables reduced motion mid-session, reveal everything. */
      reduceMotion.addEventListener('change', (e) => {
        if (e.matches) {
          items.forEach((el) => el.classList.add('is-revealed'));
          if (this.revealObserver) this.revealObserver.disconnect();
        }
      });
    }

    /* RTL is detected from the computed direction of the list element itself,
       which inherits dir="rtl" from the <html> element on Arabic pages. */
    get isRTL() {
      return this.listEl ? getComputedStyle(this.listEl).direction === 'rtl' : false;
    }

    /* Check if the active layout (grid vs carousel) depends on viewport via CSS custom prop */
    get isCarousel() {
      if (!this.listEl) return false;
      return getComputedStyle(this.listEl).getPropertyValue('--is-carousel').trim() === '1';
    }

    slide(dir) {
      if (!this.listEl || !this.isCarousel) return;
      const amount = this.listEl.offsetWidth * 0.85;
      const rtl    = this.isRTL;
      /*
        RTL Chrome/Edge: scrollLeft = 0 at right edge (start), goes negative toward left.
        scrollBy({ left: +N }) moves toward right (backward in RTL).
        scrollBy({ left: -N }) moves toward left  (forward  in RTL).
      */
      const delta = dir === 'prev'
        ? (rtl ? +amount : -amount)
        : (rtl ? -amount : +amount);
      this.listEl.scrollBy({ left: delta, behavior: 'smooth' });
    }

    refreshArrows() {
      if (!this.prevBtn || !this.nextBtn || !this.listEl || !this.isCarousel) return;
      const sl  = this.listEl.scrollLeft;
      const sw  = this.listEl.scrollWidth;
      const cw  = this.listEl.clientWidth;
      const tol = 2;
      const rtl = this.isRTL;

      if (rtl) {
        /* scrollLeft = 0 → at start (right edge) → can't go further right → prev disabled */
        this.prevBtn.disabled = sl >= -tol;
        /* scrollLeft ≈ -(sw-cw) → at end (left edge) → can't go further left → next disabled */
        this.nextBtn.disabled = sl <= -(sw - cw - tol);
      } else {
        this.prevBtn.disabled = sl <= tol;
        this.nextBtn.disabled = sl >= sw - cw - tol;
      }
    }

    setupATC() {
      this.querySelectorAll('.ai-fp__item-' + SECTION_ID).forEach(item => {
        const btn      = item.querySelector('[data-atc]');
        const selectEl = item.querySelector('[data-variant-select]');
        if (!btn) return;

        /* ═══════════════════ VARIANT DROPDOWN WIRING (WITH PRICE UPDATE) ═══════════════════ */
        if (selectEl) {
          selectEl.addEventListener('change', () => {
            const opt       = selectEl.options[selectEl.selectedIndex];
            btn.dataset.vid = opt?.value || '';
            btn.disabled    = !opt?.value || opt.disabled;
            btn.textContent = (opt?.disabled)
              ? '{{ section.settings.soldout_text }}'
              : '{{ section.settings.atc_text }}';

            // Update price when a variant is selected
            const priceWrapper = item.querySelector('[data-price-wrapper]');
            if (priceWrapper) {
              if (opt && opt.value && !opt.disabled) {
                const price = opt.getAttribute('data-variant-price');
                priceWrapper.textContent = price || '';
              } else {
                priceWrapper.textContent = {{ 'content.price_on_selection' | t | json }};
              }
            }
          });

          btn.disabled    = true;
          btn.dataset.vid = '';

          // Set initial price text on page load for multi-variant products
          const priceWrapper = item.querySelector('[data-price-wrapper]');
          if (priceWrapper) {
            const selectedOpt = selectEl.options[selectEl.selectedIndex];
            if (selectedOpt && selectedOpt.value && !selectedOpt.disabled) {
              priceWrapper.textContent = selectedOpt.getAttribute('data-variant-price') || '';
            } else {
              priceWrapper.textContent = {{ 'content.price_on_selection' | t | json }};
            }
          }
        }

        /* ═══════════════════ ATC CLICK HANDLER ═══════════════════ */
        btn.addEventListener('click', async () => {
          const vid = btn.dataset.vid;
          if (!vid || btn.disabled) return;

          const origText = btn.textContent.trim();
          btn.disabled    = true;
          btn.textContent = '{{ 'products.product.adding_to_cart' | t | default: 'جاري الإضافة...' }}';

          try {
            /* addToCartWithSections includes sections=['cart-drawer','cart-icon-bubble']
               so Shopify returns fresh HTML for those sections in data.sections */
            const data     = await addToCartWithSections(vid);
            const sections = data.sections || {};

            /* 1. Inject refreshed section HTML (cart drawer contents, icon bubble) */
            injectSectionHTML(sections);

            /* 2. Update any standalone cart count badges */
            updateCartCount(data.item_count);

            /* 3. Dispatch 'cart:update' — theme's CartAddEvent.eventName
               cart-drawer-component listens to this and auto-opens if auto-open attr is set */
            dispatchCartUpdate(data, sections);

            /* 4. Explicitly open the cart drawer */
            openCartDrawer(btn);

            btn.textContent = '{{ 'products.product.added_to_cart' | t | default: 'تمت الإضافة!' }}';

          } catch (e) {
            console.warn('[featured-products] ATC error:', e.message);
            btn.textContent = '{{ 'cart.general.cart_error' | t | default: 'خطأ — حاول مجدداً' }}';
          } finally {
            setTimeout(() => {
              btn.textContent = origText;
              if (selectEl) {
                const opt    = selectEl.options[selectEl.selectedIndex];
                btn.disabled = !opt?.value || opt.disabled;
              } else {
                btn.disabled = false;
              }
            }, 2200);
          }
        });
      });
    }
  }

  const elName = 'featured-products-section-' + SECTION_ID;
  if (!customElements.get(elName)) {
    customElements.define(elName, FeaturedProductsSection);
  }
})();
</script>

