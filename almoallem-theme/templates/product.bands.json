            "custom_liquid_RDqaVR": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "{% assign current_variant = product.selected_or_first_available_variant %}\n\n{% comment %} Only show if Shopify tracks the inventory and it's greater than 0 {% endcomment %}\n{% if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 %}\n\n<style>\n  .modern-urgency-stock {\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n    direction: rtl; /* Ensures proper Arabic text direction */\n    padding: 5px 0; \n    margin: 0px 0;\n  }\n\n  .modern-red-light {\n    width: 8px; /* Smaller, elegant dot */\n    height: 8px;\n    background-color: #e53935; /* A modern, flat red */\n    border-radius: 50%;\n    margin-left: 12px; /* Spacing for RTL */\n    position: relative;\n  }\n\n  /* Subtle ring pulse effect */\n  .modern-red-light::after {\n    content: '';\n    position: absolute;\n    top: -4px;\n    left: -4px;\n    right: -4px;\n    bottom: -4px;\n    border-radius: 50%;\n    border: 1.5px solid #e53935;\n    animation: subtle-pulse 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;\n    opacity: 0;\n  }\n\n  .modern-urgency-text {\n    color: #4a4a4a; /* Sleek dark grey instead of harsh red */\n    font-size: 15px;\n    font-weight: 500; \n    font-family: inherit;\n  }\n  \n  .modern-urgency-number {\n    color: #e53935; /* Red only for the number */\n    font-weight: 700;\n    margin-right: 4px;\n  }\n\n  @keyframes subtle-pulse {\n    0% {\n      transform: scale(0.5);\n      opacity: 0.8;\n    }\n    100% {\n      transform: scale(1.6);\n      opacity: 0;\n    }\n  }\n</style>\n\n<div class=\"modern-urgency-stock\">\n  <span class=\"modern-red-light\"></span>\n  <span class=\"modern-urgency-text\">\n    الكميات محدودة المتبقي: <span class=\"modern-urgency-number\">{{ current_variant.inventory_quantity }}</span>\n  </span>\n</div>\n\n{% endif %}"
              },
              "blocks": {}
            },
