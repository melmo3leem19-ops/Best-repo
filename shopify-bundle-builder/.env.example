# Shopify app credentials (from the Partner Dashboard -> Apps -> your app)
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret

# Public URL of this app (ngrok / Cloudflare tunnel in dev, your domain in prod)
APP_URL=https://your-app-domain.com

# Comma-separated OAuth scopes
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_discounts,read_orders

# API version pinned for Admin REST/GraphQL calls
SHOPIFY_API_VERSION=2025-01

# Server
PORT=3000

# SQLite database file (created automatically)
DATABASE_PATH=./data/bundle-builder.sqlite
