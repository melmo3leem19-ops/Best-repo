{%- comment -%}
================================================================================
  مطحنة المعلم · AL MOALLEM MILL — PACKING SLIP  ·  "EDITORIAL" (one-page A4)
  Native Shopify packing slip (Settings → Shipping and delivery → Packing slips).
  RTL Arabic + English. Boutique-luxury layout, A4 / Letter, B&W printer friendly.
--------------------------------------------------------------------------------
  PRICES / VARIANTS:
    Native slips expose only title, variant_title, sku, vendor, quantity,
    shipping_quantity, properties, groups on `line_items_in_shipment` — NOT
    prices. So each shipment line is matched back to `order.line_items` (by SKU,
    then by title + variant) to read the reliable variant title and final_price.
  PAYMENT:
    Shows "الدفع عند الاستلام · Cash on Delivery" when the gateway is COD,
    otherwise "الدفع الإلكتروني · Online Payment".
================================================================================
{%- endcomment -%}

{%- liquid
  assign logo_url = 'https://cdn.shopify.com/s/files/1/0876/0931/1266/files/IMG_8323_3fabdbaa-4a92-471d-b4d9-b5431e4f44be.png'
  assign store_name_en  = 'Al Moallem Mill'
  assign store_phone    = '+965 6680 5085'
  # returns_window: free text shown in the returns block
  assign returns_window = '٧ أيام'

  assign show_qr        = true
  assign show_barcode   = true
  assign show_signature = true
  assign show_prices    = true
  assign show_images    = true

  assign qr_provider      = 'https://api.qrserver.com/v1/create-qr-code/?size=130x130&margin=0&data='
  assign barcode_provider = 'https://barcode.tec-it.com/barcode.ashx?code=Code128&dpi=96&imagetype=Png&data='

  # Payment: if the order is marked PAID → online payment, otherwise COD
  assign is_paid = false
  if order.financial_status == 'paid'
    assign is_paid = true
  endif
-%}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>إيصال الشحن – {{ shop.name }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700&family=Amiri:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink:#3b2314; --bronze:#8b5e3c; --line:#d9cdb2; --cream:#f3ead2;
      --paper:#fdfbf5; --red:#c0392b; --green:#4a6741;
      --font-body:'Cairo',sans-serif; --font-display:'Amiri',serif;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    @page { size: A4; margin: 10mm; }

    body {
      background:#e7ddc6; font-family:var(--font-body); color:var(--ink);
      font-size:12px; line-height:1.45; padding:10px 14px 24px;
      display:flex; justify-content:center; direction:rtl; -webkit-font-smoothing:antialiased;
    }
    .sheet {
      width:760px; max-width:100%; background:var(--paper);
      padding:16px 30px 14px; position:relative; box-shadow:0 10px 50px rgba(59,35,20,.22);
    }
    .sheet::before { content:''; position:absolute; inset:8px; border:1px solid var(--bronze); opacity:.55; pointer-events:none; }
    .sheet > * { position:relative; }
    .muted { color:var(--bronze); }
    .eyebrow { font-size:9px; letter-spacing:.26em; text-transform:uppercase; color:var(--red); font-weight:700; }

    /* Crest */
    .crest { text-align:center; padding:0 0 2px; }
    .crest .logo-wrap { display:inline-block; position:relative; }
    .crest .logo { width:56px; height:56px; object-fit:contain; border-radius:50%; border:1.5px solid var(--bronze); padding:3px; background:#fff; }
    .crest .logo-fallback { width:56px; height:56px; border-radius:50%; border:1.5px solid var(--bronze); background:var(--cream); display:none; align-items:center; justify-content:center; font-family:var(--font-display); font-size:20px; font-weight:700; color:var(--red); }
    .crest .name-ar { font-family:var(--font-display); font-size:22px; font-weight:700; margin-top:3px; }
    .crest .name-en { font-size:9.5px; letter-spacing:.4em; text-transform:uppercase; color:var(--bronze); margin-top:1px; }

    /* Diamond rule */
    .rule { display:flex; align-items:center; gap:10px; margin:4px 0; }
    .rule::before, .rule::after { content:''; flex:1; height:1px; background:var(--line); }
    .rule .dot { width:6px; height:6px; background:var(--red); transform:rotate(45deg); opacity:.85; }
    .rule .dot.sm { width:4px; height:4px; background:var(--bronze); }
    .doc-title { font-family:var(--font-display); font-size:19px; letter-spacing:.1em; text-transform:uppercase; }

    /* Meta band */
    .meta-band { display:flex; border:1px solid var(--line); border-radius:3px; overflow:hidden; background:#fff; }
    .meta-cell { flex:1; padding:5px 8px; text-align:center; }
    .meta-cell + .meta-cell { border-right:1px solid var(--line); }
    .meta-cell .lbl { font-size:8px; letter-spacing:.12em; text-transform:uppercase; color:var(--bronze); }
    .meta-cell .val { font-size:13px; font-weight:700; margin-top:2px; }
    .meta-cell .val.sm { font-size:10.5px; line-height:1.3; }
    .meta-cell .val.red { color:var(--red); }
    .status-tag { display:inline-block; margin-top:3px; font-size:9.5px; font-weight:700; color:var(--green); border:1px solid var(--green); border-radius:999px; padding:1px 9px; }

    /* Addresses (Delivery + Ship To) */
    .addr-grid { display:grid; grid-template-columns:1fr 1fr; margin-top:5px; }
    .addr { padding:0 16px; }
    .addr + .addr { border-right:1px solid var(--line); }
    .addr h3 { font-size:9px; letter-spacing:.18em; text-transform:uppercase; color:var(--red); margin-bottom:4px; font-weight:700; }
    .addr .nm { font-weight:700; font-size:13px; }
    .addr .ln { font-size:12px; }
    .addr .sub { font-size:11px; color:var(--bronze); }

    /* Items */
    table.items { width:100%; border-collapse:collapse; }
    table.items thead th { font-size:9px; letter-spacing:.12em; text-transform:uppercase; color:var(--bronze); font-weight:700; text-align:right; padding:0 9px 5px; border-bottom:1.5px solid var(--ink); }
    table.items thead th.c { text-align:center; }
    table.items thead th.l { text-align:left; }
    table.items tbody td { padding:4px 8px; border-bottom:1px solid var(--line); vertical-align:top; }
    table.items tbody td.c { text-align:center; }
    table.items tbody td.l { text-align:left; }
    .idx { display:inline-flex; align-items:center; justify-content:center; width:19px; height:19px; border:1px solid var(--bronze); border-radius:50%; font-size:10px; color:var(--bronze); }
    .prod { display:flex; gap:8px; align-items:flex-start; }
    .prod-info { flex:1; }
    .thumb { width:38px; height:38px; object-fit:cover; border:1px solid var(--line); border-radius:4px; background:#fff; flex:none; }
    .thumb-ph { width:38px; height:38px; border:1px dashed var(--line); border-radius:4px; flex:none; display:flex; align-items:center; justify-content:center; color:var(--bronze); font-size:11px; }
    .it-name { font-weight:600; font-size:12.5px; }
    .it-sub { font-size:11px; color:var(--bronze); margin-top:0; }       /* variant subtitle */
    .it-meta { font-size:10px; color:var(--bronze); margin-top:0; }
    .it-meta b { color:var(--ink); }
    .it-prop { font-size:10.5px; margin-top:3px; padding-right:8px; border-right:2px solid var(--red); }
    .it-qty { font-family:var(--font-display); font-size:16px; font-weight:700; }

    /* Summary */
    .sum-wrap { display:flex; justify-content:space-between; gap:24px; margin-top:5px; flex-wrap:wrap; }
    .note { flex:1; min-width:230px; }
    .note h4 { font-size:9px; letter-spacing:.16em; text-transform:uppercase; color:var(--red); margin-bottom:3px; }
    .note p { font-size:11.5px; color:var(--bronze); line-height:1.5; }
    .sum { width:270px; }
    .sum .r { display:flex; justify-content:space-between; padding:4px 0; font-size:12.5px; }
    .sum .r .l { color:var(--bronze); }
    .sum .r .v { font-weight:600; }
    .sum .r.disc .v { color:var(--green); }
    .sum .grand { display:flex; justify-content:space-between; align-items:baseline; margin-top:6px; padding-top:9px; border-top:1.5px solid var(--ink); }
    .sum .grand .l { font-family:var(--font-display); font-size:15px; font-weight:700; }
    .sum .grand .v { font-family:var(--font-display); font-size:21px; font-weight:700; color:var(--red); }
    .partial { margin-top:10px; font-size:11px; color:var(--red); border:1px dashed var(--red); border-radius:3px; padding:6px 10px; }

    /* Combined end row: scan codes + signature on one line */
    .endrow { display:flex; gap:22px; align-items:flex-end; margin-top:5px; }
    .codes { display:flex; gap:18px; align-items:center; border:1px solid var(--line); border-radius:3px; padding:7px 12px; }
    .codes .qr img { width:68px; height:68px; display:block; }
    .codes .bc img { height:36px; max-width:170px; display:block; }
    .codes .cap { font-size:8px; letter-spacing:.08em; text-transform:uppercase; color:var(--bronze); margin-top:3px; text-align:center; }
    .signs { flex:1; display:flex; gap:20px; }
    .signs .s { flex:1; }
    .signs .s .line { border-bottom:1px solid var(--ink); height:26px; }
    .signs .s .lbl { font-size:9.5px; color:var(--bronze); margin-top:3px; }

    /* Returns */
    .returns { margin-top:7px; border-top:1px solid var(--line); padding-top:6px; }
    .returns h4 { font-size:9px; letter-spacing:.16em; text-transform:uppercase; color:var(--red); margin-bottom:3px; }
    .returns p { font-size:10.5px; line-height:1.45; }

    /* Footer */
    .foot { text-align:center; margin-top:6px; }
    .foot .thanks { font-family:var(--font-display); font-style:italic; font-size:16px; color:var(--ink); }
    .foot .links { font-size:10px; color:var(--bronze); margin-top:3px; }

    @media print {
      body { background:#fff; padding:0; }
      .sheet { width:100%; box-shadow:none; }
      .status-tag, .meta-band, .it-prop, .partial, .sum .grand .v, .codes img {
        -webkit-print-color-adjust:exact; print-color-adjust:exact;
      }
      .endrow, .returns, .foot, .sum-wrap { page-break-inside:avoid; }
      tr { page-break-inside:avoid; }
    }
    @media (max-width:800px) {
      body { padding:0; } .sheet { width:100%; }
      .addr-grid { grid-template-columns:1fr; }
      .addr + .addr { border-right:none; border-top:1px solid var(--line); padding-top:10px; margin-top:10px; }
      .endrow { flex-wrap:wrap; }
    }
  </style>
</head>
<body>
<div class="sheet">

  <!-- 1. CREST (logo + names only) -->
  <div class="crest">
    <span class="logo-wrap">
      <img class="logo" src="{{ logo_url }}" alt="{{ shop.name }}"
           onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';" />
      <span class="logo-fallback">م م</span>
    </span>
    <div class="name-ar">{{ shop.name }}</div>
    <div class="name-en">{{ store_name_en }}</div>
  </div>

  <!-- Title rule -->
  <div class="rule"><span class="dot sm"></span><span class="dot"></span>
    <span class="doc-title">إيصال الشحن · Packing Slip</span>
    <span class="dot"></span><span class="dot sm"></span></div>

  <!-- 2. META BAND -->
  <div class="meta-band">
    <div class="meta-cell">
      <div class="lbl">رقم الطلب · Order</div>
      <div class="val red">{{ order.name }}</div>
    </div>
    <div class="meta-cell">
      <div class="lbl">التاريخ · Date</div>
      <div class="val">{{ order.created_at | date: "%d %B %Y" }}</div>
    </div>
    <div class="meta-cell">
      <div class="lbl">الدفع · Payment</div>
      <div class="val sm">
        {% if is_paid %}الدفع الإلكتروني<br/>Online Payment{% else %}الدفع عند الاستلام<br/>Cash on Delivery{% endif %}
      </div>
    </div>
    <div class="meta-cell">
      <div class="lbl">الحالة · Status</div>
      <span class="status-tag">
        {% case order.fulfillment_status %}
          {% when 'fulfilled' %}مكتمل · Fulfilled
          {% when 'partial' %}جزئي · Partial
          {% when 'unfulfilled' %}قيد التجهيز · Processing
          {% else %}مؤكد · Confirmed
        {% endcase %}
      </span>
    </div>
  </div>

  <!-- 3. ADDRESSES: Delivery + Ship To -->
  <div class="addr-grid">
    <div class="addr">
      <h3>التوصيل · Delivery</h3>
      {% if delivery_method.title != blank %}<div class="ln"><b>{{ delivery_method.title }}</b></div>{% endif %}
      {% if delivery_method.instructions != blank %}<div class="sub">{{ delivery_method.instructions }}</div>{% endif %}
      {% if shipping_address.phone != blank %}<div class="sub">📞 {{ shipping_address.phone }}</div>{% endif %}
      {% if includes_all_line_items_in_order == false %}<div class="sub" style="color:var(--red);">شحنة جزئية · Partial</div>{% endif %}
    </div>
    <div class="addr">
      <h3>عنوان الشحن · Ship To</h3>
      {% if shipping_address != blank %}
        <div class="nm">{{ shipping_address.name }}</div>
        {% if shipping_address.company != blank %}<div class="ln">{{ shipping_address.company }}</div>{% endif %}
        <div class="ln">{{ shipping_address.address1 }}</div>
        {% if shipping_address.address2 != blank %}<div class="ln">{{ shipping_address.address2 }}</div>{% endif %}
        {% if shipping_address.city_province_zip != blank %}<div class="ln">{{ shipping_address.city_province_zip }}</div>{% endif %}
        <div class="ln">{{ shipping_address.country }}</div>
      {% else %}<div class="sub">—</div>{% endif %}
    </div>
  </div>

  <!-- 4. ITEMS -->
  <div class="rule"><span class="dot sm"></span>
    <span class="eyebrow">المنتجات المشحونة · Items in this shipment</span>
    <span class="dot sm"></span></div>

  <table class="items">
    <thead>
      <tr>
        <th class="c" style="width:28px;">#</th>
        <th>المنتج · Product</th>
        <th class="c" style="width:100px;">SKU</th>
        <th class="c" style="width:52px;">الكمية · Qty</th>
        {% if show_prices %}
          <th class="l" style="width:78px;">الوحدة · Unit</th>
          <th class="l" style="width:88px;">الإجمالي · Total</th>
        {% endif %}
      </tr>
    </thead>
    <tbody>
      {%- assign subtotal_price = 0 -%}
      {%- assign total_pieces = 0 -%}
      {% for line_item in line_items_in_shipment %}
        {%- comment -%} Match this shipment line back to order.line_items for the
            reliable price/variant. Native slips omit line prices, and for a
            VARIANT product order.line_items[].title is "Product - Variant" while
            the shipment title is just "Product" — so we try several keys. {%- endcomment -%}
        {%- assign matched = null -%}
        {%- assign ship_title = line_item.title -%}
        {%- assign ship_variant = line_item.variant_title -%}
        {%- comment -%} 1) SKU {%- endcomment -%}
        {%- if line_item.sku != blank -%}
          {%- for oli in order.line_items -%}
            {%- if oli.sku == line_item.sku -%}{%- assign matched = oli -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- comment -%} 2) exact title + variant {%- endcomment -%}
        {%- if matched == null -%}
          {%- for oli in order.line_items -%}
            {%- if oli.title == ship_title and oli.variant_title == ship_variant -%}{%- assign matched = oli -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- comment -%} 3) order product title + variant {%- endcomment -%}
        {%- if matched == null -%}
          {%- for oli in order.line_items -%}
            {%- if oli.product.title == ship_title and oli.variant_title == ship_variant -%}{%- assign matched = oli -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- comment -%} 4) combined order title CONTAINS product title, variant matches {%- endcomment -%}
        {%- if matched == null -%}
          {%- for oli in order.line_items -%}
            {%- if oli.title contains ship_title and oli.variant_title == ship_variant -%}{%- assign matched = oli -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- comment -%} 5) last resort: combined order title CONTAINS product title {%- endcomment -%}
        {%- if matched == null -%}
          {%- for oli in order.line_items -%}
            {%- if oli.title contains ship_title -%}{%- assign matched = oli -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- comment -%} Prefer the clean shipment variant title for display {%- endcomment -%}
        {%- assign v_title = line_item.variant_title -%}
        {%- if v_title == blank and matched %}{% assign v_title = matched.variant_title %}{% endif -%}
        {%- assign sku_val = line_item.sku -%}
        {%- if sku_val == blank and matched %}{% assign sku_val = matched.sku %}{% endif -%}
        {%- assign unit_price = 0 -%}
        {%- if matched %}{% assign unit_price = matched.final_price %}{% endif -%}
        {%- assign line_total = unit_price | times: line_item.shipping_quantity -%}
        {%- assign subtotal_price = subtotal_price | plus: line_total -%}
        {%- assign total_pieces = total_pieces | plus: line_item.shipping_quantity -%}

        <tr>
          <td class="c"><span class="idx">{{ forloop.index }}</span></td>
          <td>
            <div class="prod">
              {% if show_images %}
                {%- comment -%} Product thumbnail. Shipment lines expose line_item.image;
                    fall back to the matched order line's image. (Legacy app: use
                    `| img_url: '96x96'` instead of `| image_url: width: 96`.) {%- endcomment -%}
                {% if line_item.image %}<img class="thumb" src="{{ line_item.image | image_url: width: 96 }}" alt="">
                {% elsif matched and matched.image %}<img class="thumb" src="{{ matched.image | image_url: width: 96 }}" alt="">
                {% else %}<div class="thumb-ph">—</div>{% endif %}
              {% endif %}
              <div class="prod-info">
                <div class="it-name">{{ line_item.title }}</div>
                {% if v_title != blank and v_title != 'Default Title' %}<div class="it-sub">{{ v_title }}</div>{% endif %}
                {% if line_item.vendor != blank %}<div class="it-meta"><b>المورّد:</b> {{ line_item.vendor }}</div>{% endif %}
                {% for prop in line_item.properties %}
                  {% if prop.last != blank and prop.first != blank %}{% unless prop.first == '_' %}
                    <div class="it-prop"><b>{{ prop.first }}:</b> {{ prop.last }}</div>
                  {% endunless %}{% endif %}
                {% endfor %}
              </div>
            </div>
          </td>
          <td class="c muted" style="font-size:11px;">{% if sku_val != blank %}{{ sku_val }}{% else %}—{% endif %}</td>
          <td class="c"><span class="it-qty">{{ line_item.shipping_quantity }}</span>{% if line_item.shipping_quantity != line_item.quantity %}<span class="muted" style="font-size:11px;"> / {{ line_item.quantity }}</span>{% endif %}</td>
          {% if show_prices %}
            <td class="l">{% if matched %}{{ unit_price | money }}{% else %}—{% endif %}</td>
            <td class="l" style="font-weight:700;">{% if matched %}{{ line_total | money }}{% else %}—{% endif %}</td>
          {% endif %}
        </tr>
      {% endfor %}
    </tbody>
  </table>

  {% unless includes_all_line_items_in_order %}
    <div class="partial">⚠ بعض عناصر طلبك ستصل في شحنة منفصلة · Some items ship separately.</div>
  {% endunless %}

  <!-- 5. SUMMARY + NOTE -->
  <div class="sum-wrap">
    <div class="note">
      <h4>ملاحظات · Notes</h4>
      <p>{% if order.note != blank %}{{ order.note }}{% else %}يُرجى التحقق من سلامة المنتجات عند الاستلام.{% endif %}</p>
    </div>
    {% if show_prices %}
    <div class="sum">
      <div class="r"><span class="l">المجموع الفرعي · Subtotal</span><span class="v">{{ subtotal_price | money }}</span></div>
      {% if order.total_discounts > 0 %}<div class="r disc"><span class="l">الخصم · Discount</span><span class="v">– {{ order.total_discounts | money }}</span></div>{% endif %}
      {% if order.shipping_price > 0 %}<div class="r"><span class="l">التوصيل · Shipping</span><span class="v">{{ order.shipping_price | money }}</span></div>{% endif %}
      <div class="grand"><span class="l">الإجمالي · Total</span><span class="v">{% if order.total_price %}{{ order.total_price | money }}{% else %}{{ subtotal_price | money }}{% endif %}</span></div>
    </div>
    {% endif %}
  </div>

  <!-- 6. END ROW: scan codes (QR + barcode) + signature on one line -->
  <div class="endrow">
    {% if show_qr or show_barcode %}
    <div class="codes">
      {% if show_qr %}
        {% capture qr_data %}{{ order.name }} | {{ shipping_address.name }} | {{ order.created_at | date: "%Y-%m-%d" }} | {{ total_pieces }} pcs{% endcapture %}
        <div class="qr"><img src="{{ qr_provider }}{{ qr_data | url_encode }}" alt="QR {{ order.name }}"><div class="cap">ملخص · Summary</div></div>
      {% endif %}
      {% if show_barcode %}
        <div class="bc"><img src="{{ barcode_provider }}{{ order.name | url_encode }}" alt="Barcode {{ order.name }}"><div class="cap">{{ order.name }}</div></div>
      {% endif %}
    </div>
    {% endif %}
    {% if show_signature %}
    <div class="signs">
      <div class="s"><div class="line"></div><div class="lbl">توقيع المستلم · Received by</div></div>
      <div class="s" style="max-width:150px;"><div class="line"></div><div class="lbl">التاريخ · Date</div></div>
    </div>
    {% endif %}
  </div>

  <!-- 8. RETURNS -->
  <div class="returns">
    <h4>الإرجاع والاستبدال · Returns &amp; Exchanges</h4>
    <p>يمكن إرجاع المنتجات غير المستخدمة خلال {{ returns_window }} من الاستلام مع الاحتفاظ بهذا الإيصال.<br/>Unused items may be returned within {{ returns_window }} of delivery — please keep this slip.</p>
  </div>

  <!-- 9. FOOTER -->
  <div class="rule"><span class="dot sm"></span><span class="dot"></span><span class="dot sm"></span></div>
  <div class="foot">
    <div class="thanks">شكراً لثقتكم بـ{{ shop.name }} ✦</div>
    <div class="links">{{ shop.domain }} &nbsp;·&nbsp; {{ store_phone }} &nbsp;·&nbsp; {{ shop.email }}</div>
  </div>

</div>
</body>
</html>
