{%- comment -%}
================================================================================
  مطحنة المعلم · AL MOALLEM MILL — PREMIUM PACKING SLIP
  Shopify ORDER PRINTER app template (Apps → Order Printer → Manage templates).
  RTL Arabic + English. Print-optimised A4 / Letter.
--------------------------------------------------------------------------------
  WHY THIS VERSION
    The Order Printer app exposes the full `order`, `line_item`, `customer`,
    and address objects — so this slip can show product image THUMBNAILS,
    barcodes, vendor, product type, per-line discounts and a complete financial
    breakdown that the native packing-slip engine cannot. Use this when you want
    the maximum-detail document.
  NOTE ON FILTERS
    Newer Order Printer uses `image_url`. The legacy "Order Printer" app uses
    `img_url` instead — if thumbnails are blank, replace `image_url: width: 92`
    with `img_url: '92x92'` (see README).
--------------------------------------------------------------------------------
  Brand colours are taken from the Al Moallem logo (:root variables below).
================================================================================
{%- endcomment -%}

{%- liquid
  assign logo_url = 'https://cdn.shopify.com/s/files/1/0876/0931/1266/files/IMG_8323_3fabdbaa-4a92-471d-b4d9-b5431e4f44be.png'
  assign store_name_en   = 'Al Moallem Mill'
  assign store_phone     = '+965 6680 5085'
  assign store_country   = 'الكويت'
  assign store_tax_number = ''
  assign support_hours   = 'السبت – الخميس · 9 ص – 9 م'
  assign returns_window  = '٧ أيام'
  assign show_qr        = true
  assign show_barcode   = true
  assign show_checklist = true
  assign show_signature = true
  assign show_images    = true
  assign show_prices    = true
  assign qr_provider      = 'https://api.qrserver.com/v1/create-qr-code/?size=140x140&margin=0&data='
  assign barcode_provider = 'https://barcode.tec-it.com/barcode.ashx?code=Code128&dpi=96&imagetype=Png&data='
-%}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <title>إيصال الشحن – {{ shop.name }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;900&family=Amiri:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --brown-deep:#3b2314; --brown-mid:#8b5e3c; --brown-light:#ede0c4;
      --cream:#f5edd6; --red:#c0392b; --red-dark:#a02d23; --green:#4a6741; --white:#fff;
      --font-body:'Cairo',sans-serif; --font-display:'Amiri',serif;
    }
    *,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
    @page { size:A4; margin:12mm; }
    body { background:#d5c9b4; font-family:var(--font-body); color:var(--brown-deep); padding:30px 16px 60px; display:flex; justify-content:center; direction:rtl; }
    .slip { width:780px; max-width:100%; background:var(--cream); box-shadow:0 8px 60px rgba(59,35,20,.3); overflow:hidden; }

    .top-band { height:10px; background:linear-gradient(90deg,var(--red-dark),var(--red) 40%,var(--brown-mid)); }
    .header { background:var(--brown-deep); padding:26px 36px; display:flex; align-items:center; justify-content:space-between; gap:20px; }
    .header-logo { width:92px; height:92px; object-fit:contain; border-radius:50%; border:3px solid rgba(192,57,43,.6); background:rgba(245,237,214,.08); padding:4px; flex-shrink:0; }
    .header-logo-fallback { width:92px; height:92px; border-radius:50%; border:3px solid rgba(192,57,43,.6); background:var(--red); display:none; align-items:center; justify-content:center; font-family:var(--font-display); color:var(--cream); font-size:28px; font-weight:700; flex-shrink:0; }
    .header-info { flex:1; text-align:right; }
    .header-name-ar { font-family:var(--font-display); font-size:32px; color:var(--cream); }
    .header-name-en { font-size:12px; color:var(--brown-light); letter-spacing:2px; text-transform:uppercase; margin-top:2px; }
    .header-meta { margin-top:10px; display:flex; gap:18px; justify-content:flex-end; flex-wrap:wrap; font-size:12px; color:var(--brown-light); }
    .header-badge { flex-shrink:0; text-align:center; }
    .slip-label { background:var(--red); color:var(--cream); font-size:11px; font-weight:700; letter-spacing:3px; text-transform:uppercase; padding:5px 14px; border-radius:2px; display:block; margin-bottom:8px; }
    .slip-title-ar { font-family:var(--font-display); font-size:22px; color:var(--cream); }
    .ornament-bar { background:var(--red); height:4px; }

    .order-meta-strip { background:var(--brown-light); padding:14px 36px; display:flex; justify-content:space-between; align-items:center; border-bottom:2px solid var(--brown-mid); flex-wrap:wrap; gap:10px; }
    .meta-pill { display:flex; flex-direction:column; align-items:center; gap:2px; }
    .meta-pill-label { font-size:10px; color:var(--brown-mid); font-weight:600; text-transform:uppercase; letter-spacing:1px; }
    .meta-pill-value { font-size:14px; font-weight:700; }
    .meta-pill-value.highlight { color:var(--red); font-size:16px; }
    .status-badge { display:inline-flex; align-items:center; gap:5px; background:var(--green); color:var(--cream); font-size:11px; font-weight:700; padding:4px 12px; border-radius:20px; }
    .status-dot { width:6px; height:6px; border-radius:50%; background:#7ec87a; }

    .info-grid { display:grid; grid-template-columns:1fr 1fr 1fr; border-bottom:2px solid var(--brown-light); }
    .info-card { padding:20px 24px; }
    .info-card + .info-card { border-right:2px solid var(--brown-light); }
    .info-card-title { font-size:10px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--red); margin-bottom:12px; display:flex; align-items:center; gap:8px; }
    .info-card-title::after { content:''; flex:1; height:1px; background:var(--brown-light); }
    .info-card-body { font-size:13px; line-height:1.85; }
    .info-name { font-size:15px; font-weight:700; margin-bottom:4px; }
    .info-sub { font-size:12px; color:var(--brown-mid); }

    .section-header { padding:12px 36px; background:var(--brown-deep); display:flex; align-items:center; gap:10px; }
    .section-header-text { font-size:11px; letter-spacing:2px; text-transform:uppercase; font-weight:700; color:var(--cream); }
    .section-header-text .en { color:var(--brown-light); font-weight:400; }
    .section-header-line { flex:1; height:1px; background:rgba(245,237,214,.2); }

    .products-table { width:100%; border-collapse:collapse; }
    .products-table thead tr { background:var(--brown-mid); }
    .products-table th { padding:11px 14px; font-size:10px; letter-spacing:.5px; text-transform:uppercase; font-weight:700; color:var(--cream); text-align:right; }
    .products-table th.center, .products-table td.center { text-align:center; }
    .products-table tbody tr:nth-child(even) { background:var(--brown-light); }
    .products-table tbody tr:nth-child(odd) { background:var(--white); }
    .products-table td { padding:11px 14px; font-size:12.5px; border-bottom:1px solid rgba(139,94,60,.12); vertical-align:top; }
    .thumb { width:46px; height:46px; object-fit:cover; border:1px solid var(--brown-light); border-radius:4px; background:#fff; }
    .thumb-ph { width:46px; height:46px; border:1px dashed var(--brown-light); border-radius:4px; display:flex; align-items:center; justify-content:center; font-size:8px; color:var(--brown-mid); text-align:center; }
    .p-title { font-weight:600; }
    .p-variant { font-size:11px; background:var(--cream); border:1px solid var(--brown-light); border-radius:20px; padding:1px 9px; display:inline-block; color:var(--brown-mid); font-weight:600; margin-top:3px; }
    .p-meta { font-size:10.5px; color:var(--brown-mid); margin-top:3px; }
    .p-meta b { color:var(--brown-deep); }
    .li-prop { font-size:10.5px; margin-top:4px; padding:3px 8px; background:rgba(192,57,43,.06); border-right:2px solid var(--red); border-radius:3px; }
    .td-qty { font-weight:700; font-size:15px; }
    .strike { text-decoration:line-through; color:var(--brown-mid); font-size:10px; }

    .totals-section { display:flex; padding:22px 36px; gap:24px; align-items:flex-start; flex-wrap:wrap; }
    .totals-note { flex:1; min-width:220px; }
    .totals-note-title { font-size:11px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--brown-mid); margin-bottom:8px; }
    .totals-note-body { font-size:12px; color:var(--brown-mid); line-height:1.8; }
    .totals-box { width:300px; flex-shrink:0; border:2px solid var(--brown-light); border-radius:4px; overflow:hidden; }
    .totals-row { display:flex; justify-content:space-between; padding:9px 16px; font-size:13px; border-bottom:1px solid var(--brown-light); }
    .totals-row-label { color:var(--brown-mid); }
    .totals-row-value { font-weight:600; }
    .totals-row.discount .totals-row-value { color:var(--green); }
    .totals-row.grand { background:var(--brown-deep); border-bottom:none; padding:13px 16px; }
    .totals-row.grand .totals-row-label { color:var(--cream); font-size:15px; font-weight:700; }
    .totals-row.grand .totals-row-value { color:var(--red); font-size:18px; font-weight:900; }
    .totals-row.due .totals-row-value { color:var(--red); font-weight:700; }

    .ops-grid { display:grid; grid-template-columns:1fr 300px; border-top:2px solid var(--brown-light); }
    .ops-cell { padding:20px 28px; }
    .ops-cell + .ops-cell { border-right:2px solid var(--brown-light); }
    .ops-title { font-size:11px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--brown-mid); margin-bottom:12px; }
    .check-row { display:flex; align-items:center; gap:10px; padding:6px 0; border-bottom:1px dotted var(--brown-light); font-size:12.5px; }
    .check-row:last-child { border-bottom:0; }
    .check-box { width:16px; height:16px; border:1.5px solid var(--brown-deep); border-radius:3px; flex:none; }
    .warehouse-lines .ln { height:22px; border-bottom:1px dotted var(--brown-mid); }
    .codes { display:flex; flex-direction:column; align-items:center; gap:14px; text-align:center; }
    .codes .qr img { width:120px; height:120px; }
    .codes .bc img { height:54px; max-width:240px; }
    .codes .cap { font-size:9px; letter-spacing:.08em; text-transform:uppercase; color:var(--brown-mid); margin-top:4px; }

    .sign-section { display:flex; gap:30px; padding:18px 36px 4px; }
    .sign { flex:1; } .sign .line { border-bottom:1.5px solid var(--brown-deep); height:34px; }
    .sign .lbl { font-size:10px; color:var(--brown-mid); margin-top:6px; }

    .policy-section { display:grid; grid-template-columns:1fr 1fr; margin:16px 36px 0; border:1.5px dashed var(--brown-mid); border-radius:4px; overflow:hidden; }
    .policy-cell { padding:14px 18px; }
    .policy-cell + .policy-cell { border-right:1.5px dashed var(--brown-mid); }
    .policy-title { font-size:11px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:var(--red); margin-bottom:6px; }
    .policy-body { font-size:12px; line-height:1.7; }

    .ornament { display:flex; justify-content:center; padding:14px; }
    .footer-divider { height:4px; background:linear-gradient(90deg,var(--red),var(--brown-mid) 50%,var(--red-dark)); }
    .footer { background:var(--brown-deep); padding:20px 36px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; }
    .footer-thank { font-family:var(--font-display); font-size:20px; color:var(--cream); font-style:italic; }
    .footer-contacts { display:flex; gap:18px; flex-wrap:wrap; }
    .footer-contact-item { display:flex; align-items:center; gap:6px; font-size:12px; color:var(--brown-light); }
    .footer-contact-icon { width:28px; height:28px; border-radius:50%; background:rgba(255,255,255,.1); display:flex; align-items:center; justify-content:center; }
    .bottom-band { height:6px; background:var(--red); }

    @media print {
      body { background:#fff; padding:0; }
      .slip { width:100%; box-shadow:none; }
      .top-band,.header,.ornament-bar,.order-meta-strip,.status-badge,.section-header,
      .products-table thead tr,.products-table tbody tr:nth-child(even),.totals-row.grand,
      .footer-divider,.footer,.bottom-band,.slip-label,.codes img,.li-prop {
        -webkit-print-color-adjust:exact; print-color-adjust:exact;
      }
      .ops-grid,.sign-section,.policy-section,.footer,.totals-section { page-break-inside:avoid; }
      tr { page-break-inside:avoid; }
    }
    @media (max-width:820px){
      body{padding:0;} .slip{width:100%;}
      .info-grid,.policy-section,.ops-grid{grid-template-columns:1fr;}
      .info-card+.info-card,.ops-cell+.ops-cell,.policy-cell+.policy-cell{border-right:none;border-top:2px solid var(--brown-light);}
    }
  </style>
</head>
<body>
<div class="slip">

  <!-- ░░ HEADER ░░ -->
  <div class="top-band"></div>
  <div class="header">
    <img class="header-logo" src="{{ logo_url }}" alt="{{ shop.name }}"
         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
    <div class="header-logo-fallback">م م</div>
    <div class="header-info">
      <div class="header-name-ar">{{ shop.name }}</div>
      <div class="header-name-en">{{ store_name_en }}</div>
      <div class="header-meta">
        <span>🌐 {{ shop.domain }}</span><span>📞 {{ store_phone }}</span><span>📍 {{ store_country }}</span>
        {% if store_tax_number != blank %}<span>{{ store_tax_number }}</span>{% endif %}
      </div>
    </div>
    <div class="header-badge">
      <span class="slip-label">Packing Slip</span>
      <span class="slip-title-ar">إيصال الشحن</span>
    </div>
  </div>
  <div class="ornament-bar"></div>

  <!-- ░░ ORDER META STRIP ░░ -->
  <div class="order-meta-strip">
    <div class="meta-pill"><span class="meta-pill-label">رقم الطلب · Order</span><span class="meta-pill-value highlight">{{ order.name }}</span></div>
    <div class="meta-pill"><span class="meta-pill-label">التاريخ · Date</span><span class="meta-pill-value">{{ order.created_at | date: "%d %B %Y" }}</span></div>
    <div class="meta-pill"><span class="meta-pill-label">الدفع · Payment</span><span class="meta-pill-value">{{ order.transactions.first.gateway | default: order.gateway | default: '—' }}</span></div>
    <div class="meta-pill"><span class="meta-pill-label">الشحن · Shipping</span><span class="meta-pill-value">{{ order.shipping_method.title | default: order.shipping_lines.first.title | default: '—' }}</span></div>
    <div class="meta-pill"><span class="meta-pill-label">الحالة · Status</span>
      <span class="status-badge"><span class="status-dot"></span>
        {% case order.fulfillment_status %}
          {% when 'fulfilled' %}مكتمل · Fulfilled
          {% when 'partial' %}جزئي · Partial
          {% else %}قيد التجهيز · Processing
        {% endcase %}
      </span>
    </div>
  </div>

  <!-- ░░ INFO GRID: customer | shipping | billing ░░ -->
  <div class="info-grid">
    <div class="info-card">
      <div class="info-card-title">العميل · Customer</div>
      <div class="info-card-body">
        {% if order.customer %}
          <div class="info-name">{{ order.customer.name }}</div>
          {% if order.customer.email != blank %}<div class="info-sub">✉ {{ order.customer.email }}</div>{% endif %}
          {% if order.customer.phone != blank %}<div class="info-sub">📞 {{ order.customer.phone }}</div>
          {% elsif order.phone != blank %}<div class="info-sub">📞 {{ order.phone }}</div>{% endif %}
          {% if order.customer.id %}<div class="info-sub">ID: {{ order.customer.id }}</div>{% endif %}
        {% else %}
          <div class="info-sub">عميل زائر · Guest checkout</div>
        {% endif %}
        {% if order.tags.size > 0 %}<div class="info-sub" style="margin-top:6px;">{% for tag in order.tags %}#{{ tag }} {% endfor %}</div>{% endif %}
      </div>
    </div>

    <div class="info-card">
      <div class="info-card-title">عنوان الشحن · Ship To</div>
      <div class="info-card-body">
        {% assign sa = order.shipping_address %}
        {% if sa %}
          <div class="info-name">{{ sa.name }}</div>
          {% if sa.company != blank %}<div>{{ sa.company }}</div>{% endif %}
          <div>{{ sa.address1 }}</div>
          {% if sa.address2 != blank %}<div>{{ sa.address2 }}</div>{% endif %}
          <div>{{ sa.city }}{% if sa.province != blank %}، {{ sa.province }}{% endif %} {{ sa.zip }}</div>
          <div>{{ sa.country }}</div>
          {% if sa.phone != blank %}<div class="info-sub">📞 {{ sa.phone }}</div>{% endif %}
        {% else %}<div class="info-sub">—</div>{% endif %}
      </div>
    </div>

    <div class="info-card">
      <div class="info-card-title">عنوان الفوترة · Bill To</div>
      <div class="info-card-body">
        {% assign ba = order.billing_address %}
        {% if ba %}
          <div class="info-name">{{ ba.name }}</div>
          {% if ba.company != blank %}<div>{{ ba.company }}</div>{% endif %}
          <div>{{ ba.address1 }}</div>
          {% if ba.address2 != blank %}<div>{{ ba.address2 }}</div>{% endif %}
          <div>{{ ba.city }}{% if ba.province != blank %}، {{ ba.province }}{% endif %} {{ ba.zip }}</div>
          <div>{{ ba.country }}</div>
        {% else %}<div class="info-sub">نفس عنوان الشحن · Same as shipping</div>{% endif %}
      </div>
    </div>
  </div>

  <!-- ░░ PRODUCTS ░░ -->
  <div class="section-header">
    <span class="section-header-text">المنتجات <span class="en">/ Products</span></span>
    <div class="section-header-line"></div>
  </div>
  <table class="products-table">
    <thead>
      <tr>
        {% if show_images %}<th style="width:54px;">صورة</th>{% endif %}
        <th>المنتج · Product</th>
        <th class="center" style="width:46px;">الكمية</th>
        {% if show_prices %}
          <th style="width:70px;">الوحدة</th>
          <th style="width:60px;">الخصم</th>
          <th style="width:76px;">الإجمالي</th>
        {% endif %}
      </tr>
    </thead>
    <tbody>
      {% for line_item in order.line_items %}
      <tr>
        {% if show_images %}
        <td>
          {%- comment -%} image_url (new Order Printer). Legacy: line_item.image | img_url: '92x92' {%- endcomment -%}
          {% if line_item.image %}<img class="thumb" src="{{ line_item.image | image_url: width: 92 }}" alt="">
          {% elsif line_item.product.featured_image %}<img class="thumb" src="{{ line_item.product.featured_image | image_url: width: 92 }}" alt="">
          {% else %}<div class="thumb-ph">لا صورة</div>{% endif %}
        </td>
        {% endif %}
        <td>
          <div class="p-title">{{ line_item.title | default: line_item.product.title }}</div>
          {% if line_item.variant_title != blank and line_item.variant_title != 'Default Title' %}<span class="p-variant">{{ line_item.variant_title }}</span>{% endif %}
          <div class="p-meta">
            {% if line_item.sku != blank %}<b>SKU</b> {{ line_item.sku }}{% endif %}
            {% if line_item.variant.barcode != blank %} · <b>Barcode</b> {{ line_item.variant.barcode }}{% endif %}
          </div>
          <div class="p-meta">
            {% if line_item.vendor != blank %}<b>المورّد</b> {{ line_item.vendor }}{% endif %}
            {% if line_item.product.type != blank %} · <b>النوع</b> {{ line_item.product.type }}{% endif %}
          </div>
          {% for prop in line_item.properties %}
            {% if prop.last != blank and prop.first != '_' %}<div class="li-prop"><b>{{ prop.first }}:</b> {{ prop.last }}</div>{% endif %}
          {% endfor %}
        </td>
        <td class="center td-qty">{{ line_item.quantity }}</td>
        {% if show_prices %}
          <td>{{ line_item.price | money }}</td>
          <td>{% if line_item.total_discount > 0 %}<span style="color:var(--green);">– {{ line_item.total_discount | money }}</span>{% else %}—{% endif %}</td>
          <td style="font-weight:700;">{{ line_item.final_line_price | default: line_item.line_price | money }}</td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>

  {% if show_prices %}
  <!-- ░░ TOTALS ░░ -->
  <div class="totals-section">
    <div class="totals-note">
      <div class="totals-note-title">ملاحظات · Notes</div>
      <div class="totals-note-body">
        {% if order.note != blank %}<strong>ملاحظة العميل:</strong> {{ order.note }}<br/>{% endif %}
        {% if order.attributes['Gift message'] != blank %}<strong>🎁 رسالة هدية:</strong> {{ order.attributes['Gift message'] }}<br/>{% endif %}
        {% if order.attributes['Delivery instructions'] != blank %}<strong>التوصيل:</strong> {{ order.attributes['Delivery instructions'] }}{% endif %}
        {% if order.note == blank and order.attributes == blank %}يُرجى التحقق من سلامة المنتجات عند الاستلام.{% endif %}
      </div>
    </div>
    <div class="totals-box">
      <div class="totals-row"><span class="totals-row-label">المجموع الفرعي · Subtotal</span><span class="totals-row-value">{{ order.subtotal_price | money }}</span></div>
      {% if order.total_discounts > 0 %}<div class="totals-row discount"><span class="totals-row-label">الخصم{% if order.discount_codes.size > 0 %} ({{ order.discount_codes.first.code }}){% endif %}</span><span class="totals-row-value">– {{ order.total_discounts | money }}</span></div>{% endif %}
      {% assign ship_total = order.shipping_price | default: order.total_shipping_price %}
      <div class="totals-row"><span class="totals-row-label">الشحن · Shipping</span><span class="totals-row-value">{% if ship_total > 0 %}{{ ship_total | money }}{% else %}مجاني · Free{% endif %}</span></div>
      {% if order.tax_lines.size > 0 %}{% for tax in order.tax_lines %}<div class="totals-row"><span class="totals-row-label">{{ tax.title }} ({{ tax.rate | times: 100 }}%)</span><span class="totals-row-value">{{ tax.price | money }}</span></div>{% endfor %}
      {% elsif order.total_tax > 0 %}<div class="totals-row"><span class="totals-row-label">الضريبة · Tax</span><span class="totals-row-value">{{ order.total_tax | money }}</span></div>{% endif %}
      {% if order.total_duties > 0 %}<div class="totals-row"><span class="totals-row-label">الرسوم · Duties</span><span class="totals-row-value">{{ order.total_duties | money }}</span></div>{% endif %}
      <div class="totals-row grand"><span class="totals-row-label">الإجمالي · Total</span><span class="totals-row-value">{{ order.total_price | money }}</span></div>
      {% if order.total_refunded > 0 %}<div class="totals-row"><span class="totals-row-label">المسترجع · Refunded</span><span class="totals-row-value">– {{ order.total_refunded | money }}</span></div>{% endif %}
      {% if order.total_outstanding > 0 %}<div class="totals-row due"><span class="totals-row-label">المتبقي · Balance Due</span><span class="totals-row-value">{{ order.total_outstanding | money }}</span></div>{% endif %}
    </div>
  </div>
  {% endif %}

  <!-- ░░ OPERATIONS ░░ -->
  <div class="ops-grid">
    {% if show_checklist %}
    <div class="ops-cell">
      <div class="ops-title">قائمة التجهيز · Pick &amp; Pack</div>
      <div class="check-row"><span class="check-box"></span> تجهيز الأصناف ومطابقة الكميات · Picked &amp; verified</div>
      <div class="check-row"><span class="check-box"></span> فحص الجودة · Quality checked</div>
      <div class="check-row"><span class="check-box"></span> تغليف · Packed &amp; protected</div>
      <div class="check-row"><span class="check-box"></span> إرفاق الإيصال · Slip enclosed</div>
      <div class="check-row"><span class="check-box"></span> إغلاق ولصق العنوان · Sealed &amp; labelled</div>
      <div class="ops-title" style="margin-top:14px;">ملاحظات المستودع · Warehouse Notes</div>
      <div class="warehouse-lines"><div class="ln"></div><div class="ln"></div></div>
      <div style="margin-top:8px; font-size:11px; color:var(--brown-mid);">تم التجهيز بواسطة · Packed by __________ التاريخ __________</div>
    </div>
    {% endif %}
    {% if show_qr or show_barcode %}
    <div class="ops-cell">
      <div class="ops-title" style="text-align:center;">المسح والتتبع · Scan</div>
      <div class="codes">
        {% if show_qr %}
          {% capture qr_data %}{{ order.name }} | {{ order.customer.name }} | {{ order.created_at | date: "%Y-%m-%d" }} | {{ order.line_items.size }} items{% endcapture %}
          <div class="qr"><img src="{{ qr_provider }}{{ qr_data | url_encode }}" alt="QR {{ order.name }}"><div class="cap">ملخص الطلب · Summary</div></div>
        {% endif %}
        {% if show_barcode %}
          <div class="bc"><img src="{{ barcode_provider }}{{ order.name | url_encode }}" alt="Barcode {{ order.name }}"><div class="cap">{{ order.name }}</div></div>
        {% endif %}
      </div>
    </div>
    {% endif %}
  </div>

  {% if show_signature %}
  <div class="sign-section">
    <div class="sign"><div class="line"></div><div class="lbl">توقيع المستلم · Received by (signature)</div></div>
    <div class="sign" style="max-width:180px;"><div class="line"></div><div class="lbl">التاريخ · Date</div></div>
  </div>
  {% endif %}

  <!-- ░░ POLICY + SUPPORT ░░ -->
  <div class="policy-section">
    <div class="policy-cell">
      <div class="policy-title">الإرجاع والاستبدال · Returns</div>
      <div class="policy-body">يمكن إرجاع المنتجات غير المستخدمة خلال {{ returns_window }} من الاستلام.<br/>Unused items may be returned within {{ returns_window }} of delivery.</div>
    </div>
    <div class="policy-cell">
      <div class="policy-title">خدمة العملاء · Customer Care</div>
      <div class="policy-body">📞 {{ store_phone }}<br/>✉ {{ shop.email }}<br/>🕑 {{ support_hours }}</div>
    </div>
  </div>

  <div class="ornament">
    <svg width="320" height="20" viewBox="0 0 320 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <line x1="0" y1="10" x2="120" y2="10" stroke="#8b5e3c" stroke-width="1" stroke-opacity=".5"/>
      <polygon points="140,4 146,10 140,16 134,10" fill="#c0392b" opacity=".7"/>
      <polygon points="160,4 166,10 160,16 154,10" fill="#c0392b" opacity=".4"/>
      <polygon points="180,4 186,10 180,16 174,10" fill="#c0392b" opacity=".7"/>
      <line x1="200" y1="10" x2="320" y2="10" stroke="#8b5e3c" stroke-width="1" stroke-opacity=".5"/>
    </svg>
  </div>

  <div class="footer-divider"></div>
  <div class="footer">
    <div class="footer-thank">شكراً لثقتكم بـ{{ shop.name }} ✦</div>
    <div class="footer-contacts">
      <div class="footer-contact-item"><div class="footer-contact-icon">🌐</div>{{ shop.domain }}</div>
      <div class="footer-contact-item"><div class="footer-contact-icon">📞</div>{{ store_phone }}</div>
      <div class="footer-contact-item"><div class="footer-contact-icon">✉</div>{{ shop.email }}</div>
    </div>
  </div>
  <div class="bottom-band"></div>

</div>
</body>
</html>
